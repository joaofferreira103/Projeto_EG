home "Apartamento" {
  const night_start : time = 22:30;
  const morning : time = 07:00;
  const comfort : real = 21.5;
  const night_offset : real = -1.5;
  const max_load : real = 2000.0;
  var away : bool = false;

  group night_lights = [Floor1.Living.lamp, Floor1.Hall.lamp, Floor2.Bedroom.lamp];
  group heaters = [Floor1.Living.heater, Floor2.Bedroom.heater];

  scene eco_mode {
    for h in heaters { h.target_temp = comfort + night_offset; }
  }

  scene goodnight {
    for l in night_lights { l.turn_off(); }
    Floor2.Bedroom.shade.position = 0;
    Floor1.Hall.door.lock();
    activate eco_mode;
    notify "Boa noite!";
  }

  scene wake_up {
    Floor2.Bedroom.shade.position = 100;
    Floor2.Bedroom.lamp.fade_to(60);
  }

  zone Floor1 {
    var visits : int = 0;

    zone Living {
      device lamp : dimmer;
      device motion : motion_sensor;
      device heater : thermostat;

      rule welcome on signal motion.motion_detected when not away {
        lamp.turn_on();
        lamp.brightness = 30;
        visits = visits + 1;
        if visits % 10 == 0 { notify "Mais 10 visitas"; }
      }

      rule night_dim priority 1
        on signal motion.motion_detected
        when (now > night_start or now < morning) and not away {
        lamp.brightness = 10;
      }

      rule keep_warm on change heater.current_temp {
        var gap : real = comfort - heater.current_temp;
        if gap > 2.0 {
          heater.target_temp = comfort + 1;
        } else if gap > 0.5 {
          heater.target_temp = comfort;
        } else {
          heater.target_temp = comfort + night_offset;
        }
      }
    }

    zone Kitchen {
      device oven : plug;

      rule overload on every 5 min when oven.consumption > max_load {
        oven.turn_off();
        notify "Consumo excessivo no forno";
      }
    }

    zone Hall {
      device lamp : dimmer;
      device door : door_lock;

      rule door_alert on signal door.opened when away {
        notify "Porta aberta com a casa vazia";
      }
    }
  }

  zone Floor2 {
    zone Bedroom {
      device lamp : dimmer;
      device heater : thermostat;
      device shade : blind;
      device probe : temp_sensor;

      rule ventilate on change probe.value when probe.value > 26.0 {
        shade.position = 100;
      }
    }
  }

  rule bedtime on at 23:00 {
    repeat 3 times { notify "Hora de dormir"; wait 1 min; }
    activate goodnight;
  }

  rule morning_routine on at 07:00 {
    activate wake_up;
  }
}
